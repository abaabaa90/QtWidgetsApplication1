/* ===== Title Bar ===== */
QWidget#titleBar {
    background-color: #1E1E2E;
}

QWidget#contentWidget {
    background-color: #B6B6B6;
}

/* ===== Title Bar Buttons ===== */
QPushButton#minButton,
QPushButton#maxButton {
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
    color: white;
    background: transparent;
}

QPushButton#minButton:hover,
QPushButton#maxButton:hover {
    background-color: rgba(255, 255, 255, 30);
}

QPushButton#closeButton {
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
    color: white;
    background: transparent;
}

QPushButton#closeButton:hover {
    background-color: #E81123;
    color: white;
}

/* ===== Nav Bar ===== */
QWidget#navBar {
    background-color: #B6B6B6;
    border-right: 1px solid #A0A0A0;
}

QLabel#navTitle {
    color: #3C3C3C;
    background: transparent;
    padding: 4px 0;
}

QFrame#navSep {
    background-color: #A0A0A0;
    max-height: 1px;
}

QPushButton#navButton {
    background-color: #C8C8C8;
    color: #323232;
    border: 1px solid #A0A0A0;
    border-radius: 4px;
    font-size: 18px;
    padding: 10px 6px;
}

QPushButton#navButton:hover {
    background-color: #D2D2D2;
    border: 1px solid #8C8C8C;
}

QPushButton#navButton:checked {
    background-color: #A0A0A0;
    border: 1px solid #787878;
    font-weight: bold;
}

/* ===== Content Area ===== */
QWidget#mainStackedWidget {
    background-color: #B6B6B6;
}

QLabel#pageTitle {
    color: #323232;
    padding-bottom: 8px;
}

QLabel#pagePlaceholder {
    color: #505050;
    font-size: 18px;
    background-color: #C8C8C8;
    border: 1px solid #A0A0A0;
    border-radius: 8px;
    padding: 40px;
}

/* ===== Splitter Handle ===== */
QSplitter::handle {
    background-color: #A0A0A0;
    width: 3px;
}

QSplitter::handle:hover {
    background-color: #787878;
}

/* ===== Render View Splitter Handle ===== */
QSplitter#renderViewSplitter::handle {
    background-color: #787878;
    width: 4px;
}

QSplitter#renderViewSplitter::handle:hover {
    background-color: #4682C8;
}

/* ===== Render View Frame Pages ===== */
QWidget#renderViewNormalPage,
QWidget#renderViewMaxPage {
    background-color: #B6B6B6;
}
